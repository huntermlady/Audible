{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huntermlady.github.io/Audible/schemas/fact_sheet.schema.json",
  "title": "FactSheet",
  "description": "Deterministic bundle of facts handed to the model. derived is null for matchup and team contexts. Selection/order rules: shared/factsheet/SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fact_sheet_version",
    "context",
    "derived",
    "facts"
  ],
  "properties": {
    "fact_sheet_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "context": {
      "$ref": "#/$defs/FactSheetContext"
    },
    "derived": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactSheetDerived"
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "maxItems": 40
    }
  },
  "$defs": {
    "Fact": {
      "title": "Fact",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "display",
        "unit",
        "n",
        "low_sample",
        "league_value",
        "league_display"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}\\.(off|def)\\.[0-9]{4}\\.(overall|down_dist|down_dist_zone|zone|score_time|down_dist_score_time)\\.[a-z0-9_-]+\\.[a-z_]+$",
          "description": "{team}.{side}.{season}.{grouping}.{cell_key}.{metric}"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "display": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": [
            "rate",
            "epa",
            "count",
            "yards"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "low_sample": {
          "type": "boolean"
        },
        "league_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "league_display": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "FactSheetContext": {
      "title": "FactSheetContext",
      "oneOf": [
        {
          "$ref": "#/$defs/MatchupFactSheetContext"
        },
        {
          "$ref": "#/$defs/SituationFactSheetContext"
        },
        {
          "$ref": "#/$defs/TeamFactSheetContext"
        }
      ]
    },
    "MatchupFactSheetContext": {
      "title": "MatchupFactSheetContext",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "game_id",
        "season",
        "team",
        "opponent",
        "role"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "matchup"
        },
        "game_id": {
          "type": "string",
          "pattern": "^[0-9]{4}_[0-9]{2}_[A-Z]{2,3}_[A-Z]{2,3}$"
        },
        "season": {
          "type": "integer",
          "minimum": 1999,
          "maximum": 2100
        },
        "team": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$"
        },
        "opponent": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "OC",
            "DC"
          ]
        }
      }
    },
    "SituationFactSheetContext": {
      "title": "SituationFactSheetContext",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "situation"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "situation"
        },
        "situation": {
          "$ref": "situation.schema.json"
        }
      }
    },
    "TeamFactSheetContext": {
      "title": "TeamFactSheetContext",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "season",
        "team"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "team"
        },
        "season": {
          "type": "integer",
          "minimum": 1999,
          "maximum": 2100
        },
        "team": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$"
        }
      }
    },
    "FactSheetDerived": {
      "title": "FactSheetDerived",
      "description": "Buckets derived from the Situation (situation context only).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "down",
        "dist_bucket",
        "field_zone",
        "score_state",
        "time_bucket"
      ],
      "properties": {
        "down": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "dist_bucket": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long",
            "very_long"
          ]
        },
        "field_zone": {
          "type": "string",
          "enum": [
            "backed_up",
            "own_territory",
            "opp_territory",
            "red_zone"
          ]
        },
        "score_state": {
          "type": "string",
          "enum": [
            "trail_9plus",
            "trail_1_8",
            "tied",
            "lead_1_8",
            "lead_9plus"
          ]
        },
        "time_bucket": {
          "type": "string",
          "enum": [
            "two_minute",
            "fourth_quarter",
            "normal"
          ]
        }
      }
    }
  }
}
