{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huntermlady.github.io/Audible/schemas/report_index_entry.schema.json",
  "title": "ReportIndexEntry",
  "description": "One entry of reports/index.json (an array of these).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "season",
    "week",
    "game_id",
    "team",
    "opponent",
    "role",
    "path",
    "generated_at",
    "stats_as_of",
    "model",
    "validation_status"
  ],
  "properties": {
    "season": {
      "type": "integer",
      "minimum": 1999,
      "maximum": 2100
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22
    },
    "game_id": {
      "type": "string",
      "pattern": "^[0-9]{4}_[0-9]{2}_[A-Z]{2,3}_[A-Z]{2,3}$"
    },
    "team": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$"
    },
    "opponent": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "OC",
        "DC"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^[0-9]{4}/[0-9]{1,2}/[0-9]{4}_[0-9]{2}_[A-Z]{2,3}_[A-Z]{2,3}\\.[A-Z]{2,3}\\.(OC|DC)\\.json$",
      "description": "Relative to reports/, week unpadded."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stats_as_of": {
      "type": "string",
      "format": "date"
    },
    "model": {
      "type": "string"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    }
  }
}
