{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huntermlady.github.io/Audible/schemas/schedule_game.schema.json",
  "title": "ScheduleGame",
  "description": "One game in data/schedule.json (an array of these). Scores are null for unplayed games.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "game_id",
    "season",
    "week",
    "game_type",
    "gameday",
    "gametime",
    "home_team",
    "away_team",
    "home_score",
    "away_score",
    "stadium",
    "spread_line",
    "total_line"
  ],
  "properties": {
    "game_id": {
      "type": "string",
      "pattern": "^[0-9]{4}_[0-9]{2}_[A-Z]{2,3}_[A-Z]{2,3}$"
    },
    "season": {
      "type": "integer",
      "minimum": 1999,
      "maximum": 2100
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22
    },
    "game_type": {
      "type": "string",
      "enum": [
        "REG",
        "WC",
        "DIV",
        "CON",
        "SB"
      ]
    },
    "gameday": {
      "type": "string",
      "format": "date"
    },
    "gametime": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "home_team": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$"
    },
    "away_team": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}$"
    },
    "home_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "away_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "stadium": {
      "type": [
        "string",
        "null"
      ]
    },
    "spread_line": {
      "type": [
        "number",
        "null"
      ]
    },
    "total_line": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}
