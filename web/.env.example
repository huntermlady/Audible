# Copy to web/.env.local (gitignored) for local development.
# VITE_* values are PUBLIC: Vite inlines them into the browser bundle. Never put secrets here
# (ANTHROPIC_API_KEY lives in the repo-root .env and is only read by the dev server).

# Base URL of the audible-ai Cloudflare Worker (Ollama-compatible /api/tags + /api/chat), no
# trailing slash. Used by live-AI "auto"/"cloud" modes when local Ollama isn't reachable.
# Leave empty to disable cloud mode. For deploys, set the GitHub Actions repo variable
# VITE_AI_CLOUD_URL instead. The Worker must list your origin (http://localhost:5173,
# http://localhost:4173) in ALLOWED_ORIGINS.
VITE_AI_CLOUD_URL=
